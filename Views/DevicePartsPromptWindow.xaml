<Window x:Class="KeyPulse.Views.DevicePartsPromptWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource AppWindowStyle}" Title="{Binding Title}"
 Width="380" SizeToContent="Height" MaxHeight="420" ResizeMode="NoResize"
 ShowInTaskbar="False" ShowActivated="False" Topmost="True">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Still using these parts?" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="{Binding Switches}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Keycaps}" TextWrapping="Wrap" Margin="0,0,0,16"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Same" Click="SameClick" Padding="16,6" Margin="0,0,8,0" Focusable="False"/>
   <Button Content="Change" Click="ChangeClick" Padding="16,6" Focusable="False"/>
  </StackPanel>
 </Grid>
</Window>
